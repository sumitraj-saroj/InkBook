# Maintainer: Sumiraj Saroj <sumirajsaroj@example.com>
pkgname=inkbook
pkgver=0.1.0
pkgrel=1
pkgdesc="Handwritten digital notebook powered by Excalidraw with fixed page boundaries"
arch=('x86_64')
url="https://github.com/sumirajsaroj/InkBook"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss')
makedepends=('nodejs' 'npm')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/InkBook-$pkgver"
  npm ci --prefer-offline --no-audit --no-fund
  npm run build:unpack
}

package() {
  cd "$srcdir/InkBook-$pkgver"

  # Install application bundle to /opt/inkbook
  install -dm755 "$pkgdir/opt/inkbook"
  cp -a dist/linux-unpacked/* "$pkgdir/opt/inkbook/"

  # Symlink binary into /usr/bin
  install -dm755 "$pkgdir/usr/bin"
  ln -sf /opt/inkbook/inkbook "$pkgdir/usr/bin/inkbook"

  # Install desktop entry
  install -Dm644 packaging/linux/inkbook.desktop "$pkgdir/usr/share/applications/inkbook.desktop"

  # Install MIME type XML
  install -Dm644 packaging/linux/inkbook.xml "$pkgdir/usr/share/mime/packages/inkbook.xml"

  # Install icons in standard freedesktop directories
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "resources/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/inkbook.png"
  done
  install -Dm644 resources/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/inkbook.svg"

  # Install license and notice
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
